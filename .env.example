# Generation requires Groq or OpenRouter. Gemini is a summary fallback only.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_EVAL_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional dense retrieval (also install uv's inference extra).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
TAVILY_API_KEY=

DATA_ROOT=data
MAX_UPLOAD_SIZE_MB=20
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:5173"]
LOG_LEVEL=INFO

# Reserved; application tracing and authentication are not wired up.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
SECRET_KEY=change-me-to-a-strong-secret-key
